{
  "name": "netscope-local",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "墨流 NetScope — local Windows traffic observatory",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "mcp": "node mcp.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "test:desktop": "dotnet run --project test/desktop/NetScope.TrayTests.csproj --configuration Release",
    "build": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "package:windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/empireYJ/NetScope.git"
  },
  "bugs": {
    "url": "https://github.com/empireYJ/NetScope/issues"
  },
  "homepage": "https://github.com/empireYJ/NetScope#readme"
}
